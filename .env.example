# ===== Server =====
# Host and port the local proxy listens on
HOST=127.0.0.1
PORT=8082

# ===== Upstream OpenAI-compatible backend =====
# Base URL of the OpenAI-compatible API (no trailing /v1 needed, add if your provider uses it)
# Examples:
#   OpenAI:        https://api.openai.com/v1
#   Together:      https://api.together.xyz/v1
#   Groq:          https://api.groq.com/openai/v1
#   Local Ollama:  http://localhost:11434/v1
#   LM Studio:     http://localhost:1234/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# API key for the upstream provider
OPENAI_API_KEY=sk-your-key-here

# ===== Model mapping =====
# Claude Code sends Anthropic model names (e.g. claude-3-5-sonnet, claude-3-5-haiku).
# Map the "big" (sonnet/opus) and "small" (haiku) tiers to your OpenAI-compatible models.
BIG_MODEL=gpt-4o
SMALL_MODEL=gpt-4o-mini

# ===== Optional =====
# Request timeout in seconds
REQUEST_TIMEOUT=120
# Max tokens cap (some providers reject very large values). 0 = no cap.
MAX_TOKENS_LIMIT=0
# Optional key that Claude Code must send (leave empty to disable auth check)
ANTHROPIC_API_KEY=
